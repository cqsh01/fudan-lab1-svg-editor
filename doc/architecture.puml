@startuml
skinparam backgroundColor #F7F9FC
skinparam componentStyle rectangle
skinparam shadowing false
skinparam roundcorner 10
skinparam ArrowColor #5B8C7C
skinparam componentBackgroundColor #FFFFFF
skinparam componentBorderColor #133F4B
skinparam componentFontColor #133F4B
left to right direction
package "CLI" {
  component "Main\ncomposition root" as Main
  component "EditorShell / Cli\nUnsavedChangesGuard / Parser" as CommandUI
}
package "Application" {
  component "EditorSession\nCommands / History" as App
  component "TerminalView\nCharacterRenderer / CharacterCanvas\nTerminalText" as CharView
  interface "SvgStore" as Svg
  interface "RecoveryStore" as Draft
  interface "Terminal" as Term
  interface "Preview" as View
  interface "PreviewSource" as Source
}
component "Domain\nShape / Group / SvgDocument\nShapeVisitor" as Domain
package "Infrastructure" {
  component "FileSvgStore\nSvgCodec" as IO
  component "FileRecoveryStore\nAtomicFileWriter" as Recovery
  component "ConsoleTerminal" as Console
  component "PreviewServer\nPreviewPage" as HTTP
}
actor "Browser\nread-only view" as Browser
Main --> CommandUI : inject adapters
CommandUI --> App : execute
CommandUI --> Term
CommandUI --> Draft : checkpoint
CommandUI --> View : start / stop
CommandUI --> CharView
App --> CharView : ViewCommand
CharView --> Domain : visit snapshot shapes
CharView --> Term : read dimensions
App --> Domain
App --> Svg
App ..|> Source
IO ..|> Svg
IO --> Domain
Recovery ..|> Draft
Recovery --> Domain
Console ..|> Term
HTTP ..|> View
HTTP --> Source : read snapshots
HTTP --> Domain
Browser --> HTTP : GET state / image
note bottom of HTTP : 127.0.0.1 only; random URL\nno commands or file routes
@enduml
