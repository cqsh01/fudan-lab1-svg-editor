{
  "name": "lab1-svg-editor",
  "version": "0.3.0",
  "private": true,
  "description": "A small, object-oriented SVG editor with a scriptable CLI.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "node dist/src/cli/Main.js",
    "start": "node dist/src/cli/Main.js",
    "test": "npm run build --silent && node --test dist/test/*.test.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "package": "npm pack",
    "test:package": "npm run build --silent && node dist/tools/PackageSmoke.js"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "bin": {
    "svg-editor": "dist/src/cli/Main.js"
  },
  "files": [
    "dist/src/",
    "README.md",
    "doc/",
    "examples/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cqsh01/fudan-lab1-svg-editor.git"
  }
}
