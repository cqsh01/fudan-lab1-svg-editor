{
  "name": "lab1-svg-editor",
  "version": "0.1.0",
  "private": true,
  "description": "A small, object-oriented SVG editor with a scriptable CLI.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "npm run build --silent && node dist/src/cli/Main.js",
    "start": "node dist/src/cli/Main.js",
    "test": "npm run build --silent && node --test dist/test/*.test.js",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
